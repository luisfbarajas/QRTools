{
  "expo": {
    "name": "QRTools",
    "slug": "QRTools",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static",
            "deploymentTarget": "15.1"
          },
          "android": {
            "extraProguardRules": "-keep class com.google.android.gms.internal.consent_sdk.** { *; }",
            "kotlinVersion": "1.7.20",
            "compileSdkVersion": 33,
            "minSdkVersion": 23,
            "targetSdkVersion": 33,
            "buildToolsVersion": "34.0.0"
          }
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "delayAppMeasurementInit": true,
          "androidAppId": "ca-app-pub-1852695105357554~6875558241",
          "iosAppId": "ca-app-pub-1852695105357554/8174608728",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalized ads to you.",
          "skAdNetworkItems": [
            {
              "skAdNetworkIdentifier": "cstr6suwn9.skadnetwork"
            },
            {
              "skAdNetworkIdentifier": "4fzdc2evr5.skadnetwork"
            }
          ]
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryAddUsageDescription": "We need your permission to save QR codes to your photo library",
        "NSPhotoLibraryUsageDescription": "We need your permission to access your photo library",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.lbarajas.QRTools"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "WRITE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "package": "com.lbarajas.QRTools"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "9ee76382-6d2d-4e0f-86e4-4f813b171e19"
      }
    }
  }
}
